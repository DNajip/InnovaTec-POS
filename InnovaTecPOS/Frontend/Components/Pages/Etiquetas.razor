        font-size: 1.2rem;
        box-shadow: 0 4px 10px rgba(26, 42, 108, 0.2);
    }

    .header-titles h1 {
        font-size: 1.2rem;
        font-weight: 800;
        color: #1a2a6c;
        margin-bottom: 0;
    }

    .header-titles p {
        margin-bottom: 0;
        color: #6c757d;
        font-weight: 500;
        font-size: 0.8rem;
    }

    .btn-premium-action {
        background: #1a2a6c;
        color: white;
        border: none;
        padding: 0.8rem 1.5rem;
        border-radius: 12px;
        font-weight: 600;
        transition: all 0.3s ease;
        box-shadow: 0 4px 15px rgba(26, 42, 108, 0.3);
