            black 1px, transparent 1px,
            black 4px, transparent 4px,
            black 2px, transparent 2px,
            black 1px, transparent 1px,
            black 6px, transparent 6px,
            black 2px, transparent 2px,
            black 3px, transparent 3px,
            black 1px, transparent 1px,
            black 4px, transparent 4px,
