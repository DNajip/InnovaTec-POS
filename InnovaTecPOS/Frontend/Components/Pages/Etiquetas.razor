        background: #1e3a8a;
    }

    .etiquetas-workspace {
        display: grid;
        grid-template-columns: 380px minmax(400px, 850px);
        gap: 1.5rem;
        align-items: start;
        width: 100%;
    }

    .panel-card {
        background: white;
        border-radius: 20px;
        height: 100%;
        display: flex;
        flex-direction: column;
        border: 1px solid rgba(0,0,0,0.05);
        overflow: hidden;
    }

    .panel-header {
        padding: 1rem 1.25rem;
        border-bottom: 1px solid #eee;
    }

    .panel-header h3 {
