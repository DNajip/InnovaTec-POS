    }

    .btn-page {
        width: 35px;
        height: 35px;
        border-radius: 10px;
        border: 1px solid #eee;
        background: white;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #1a2a6c;
        transition: all 0.2s;
