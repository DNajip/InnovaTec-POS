@page "/etiquetas"
@using InnovaTecPOS.Backend.Models
@using InnovaTecPOS.Backend.Services
@using InnovaTecPOS.Frontend.Components.UI
@inject IProductService ProductService
@inject UserSession Session
@inject NavigationManager Navigation
@inject ToastService Toast
@inject IJSRuntime JS

<div class="etiquetas-premium-container animate__animated animate__fadeIn">
    <!-- Header Refinado -->
    <div class="etiquetas-header-glass">
        <div class="header-left">
            <div class="brand-icon">
                <i class="fas fa-barcode"></i>
            </div>
            <div class="header-titles">
                <h1>Gestión de Etiquetas</h1>
                <p>Genera y asocia códigos de barras para optimizar tu facturación</p>
            </div>
        </div>
        <div class="header-right">
            <button class="btn-premium-action" @onclick="() => showNewProductModal = true">
                <i class="fas fa-plus-circle me-2"></i> Nuevo Producto
            </button>
        </div>
    </div>

    <div class="etiquetas-workspace">
        <!-- Panel Izquierdo: Generador -->
        <div class="workspace-panel panel-generator">
            <div class="panel-card shadow-premium">
                <div class="panel-header">
                    <h3><i class="fas fa-magic me-2"></i> Generador de Código</h3>
                </div>
                <div class="panel-body text-center">
                    <div class="barcode-preview-area mx-auto">
                        @if (!string.IsNullOrEmpty(generatedBarcode))
                        {
                            <div class="barcode-visual mx-auto">
                                <svg id="barcode-canvas" style="width: 100%; max-height: 80px;"></svg>
                                <span class="barcode-number">@generatedBarcode</span>
                            </div>
                        }
                        else
                        {
                            <div class="barcode-placeholder">
                                <i class="fas fa-qrcode mb-2"></i>
                                <span>Presiona generar para comenzar</span>
                            </div>
                        }
                    </div>

                    <div class="generator-controls d-flex flex-column align-items-center">
                        <button class="btn btn-primary mb-3 py-2 px-4 rounded-pill shadow-sm fw-bold" style="width: auto; min-width: 200px;" @onclick="GenerateCode">
                            <i class="fas fa-sync-alt me-2"></i> Generar Nuevo Código
                        </button>
                        
                        <div class="input-group-premium w-100" style="max-width: 280px;">
                            <label class="d-block mb-1 small fw-bold text-muted text-uppercase">Código Manual</label>
                            <input type="text" class="form-control text-center fw-bold" @bind="generatedBarcode" @bind:after="UpdateBarcode" placeholder="Escribir aquí..." />
                        </div>
                    </div>
                </div>
                <div class="panel-footer bg-light border-top-0 pt-0 pb-3">
                    <div class="alert alert-info py-2 px-3 rounded-4 small mb-0 border-0 mx-auto" style="max-width: 320px; font-size: 0.75rem;">
                        <i class="fas fa-info-circle me-1"></i> Genera un código único para asociarlo a un producto.
                    </div>
                </div>
            </div>
        </div>

        <!-- Panel Derecho: Asociación -->
        <div class="workspace-panel panel-association">
            <div class="panel-card shadow-premium">
                <div class="panel-header">
                    <h3><i class="fas fa-link me-2"></i> Vincular con Producto</h3>
                </div>
                <div class="panel-body">
                    <div class="search-box-premium mb-4 mx-auto">
                        <i class="fas fa-search search-icon"></i>
                        <input type="text" class="search-input" placeholder="Buscar producto por nombre..." 
                               @bind="searchTerm" @bind:event="oninput" @onkeyup="HandleSearch" />
                    </div>

                    <div class="product-selection-list custom-scrollbar mx-auto w-100">
                        @if (isSearching)
                        {
                            <div class="text-center py-5">
                                <div class="spinner-border text-primary" role="status"></div>
                                <p class="mt-2 text-muted">Buscando productos...</p>
                            </div>
                        }
                        else if (!PagedResults.Any())
                        {
                            <div class="empty-results py-5 text-center">
                                <i class="fas fa-box-open fa-3x text-muted mb-3 opacity-30"></i>
                                <p class="text-muted">No se encontraron productos o no se ha buscado.</p>
                            </div>
                        }
                        else
                        {
                            @foreach (var prod in PagedResults)
                            {
                                <div class="product-item @(selectedProduct?.IdProducto == prod.IdProducto ? "selected" : "")" 
                                     @onclick="() => SelectProduct(prod)">
                                    <div class="product-info d-flex align-items-center gap-2 flex-wrap">
                                        <span class="product-name mb-0">@prod.Nombre</span>
                                        <span class="product-meta opacity-75">| @prod.Marca @prod.Modelo | @(prod.CodigoBarras ?? "Sin Código")</span>
                                    </div>
                                    <div class="product-status">
                                        @if (string.IsNullOrEmpty(prod.CodigoBarras))
                                        {
                                            <span class="badge bg-warning text-dark rounded-pill px-2">Pendiente</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success rounded-pill px-2">Asociado</span>
                                        }
                                    </div>
                                </div>
                            }
                        }
                    </div>

                    @if (TotalPages > 1)
                    {
                        <div class="pagination-container d-flex align-items-center p-3 border-top mx-auto w-100">
                            <div class="flex-grow-1">
                                <span class="small text-muted">@searchResults.Count encontrados</span>
                            </div>
                            <div class="pagination-carousel-container">
                                <ul class="pagination pagination-premium mb-0">
                                    <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                                        <button class="page-link py-1" @onclick="() => SetPage(currentPage - 1)" title="Anterior">
                                            <i class="fas fa-chevron-left"></i>
                                        </button>
                                    </li>
                                    
                                    @{
                                        // Lógica de ventana deslizante (Carrusel de 6 números)
                                        int maxVisible = 6;
                                        int startPage = Math.Max(1, Math.Min(currentPage - 2, TotalPages - maxVisible + 1));
                                        int endPage = Math.Min(TotalPages, startPage + maxVisible - 1);
                                        
                                        // Re-ajustar si estamos cerca del final
                                        if (TotalPages > maxVisible && endPage == TotalPages) startPage = Math.Max(1, TotalPages - maxVisible + 1);

                                        for (int i = startPage; i <= endPage; i++)
                                        {
                                            var pageNum = i;
                                            <li class="page-item @(currentPage == pageNum ? "active" : "") page-item-animated" @key="pageNum">
                                                <button class="page-link py-1" @onclick="() => SetPage(pageNum)">@pageNum</button>
                                            </li>
                                        }

                                        // Mostrar Elipsis y Última Página si es necesario
                                        if (endPage < TotalPages)
                                        {
                                            if (endPage < TotalPages - 1)
                                            {
                                                <li class="pagination-ellipsis px-1">...</li>
                                            }
                                            <li class="page-item @(currentPage == TotalPages ? "active" : "") page-item-animated">
                                                <button class="page-link py-1" @onclick="() => SetPage(TotalPages)">@TotalPages</button>
                                            </li>
                                        }
                                    }

                                    <li class="page-item @(currentPage == TotalPages ? "disabled" : "")">
                                        <button class="page-link py-1" @onclick="() => SetPage(currentPage + 1)" title="Siguiente">
                                            <i class="fas fa-chevron-right"></i>
                                        </button>
                                    </li>
                                </ul>
                            </div>
                            <div class="flex-grow-1 text-end">
                                <span class="small text-muted">Pág. @currentPage</span>
                            </div>
                        </div>
                    }
                </div>
                <div class="panel-footer bg-light border-top-0 pt-0 pb-3 text-center">
                    <button class="btn btn-success py-2 px-5 rounded-pill fw-bold shadow-lg" 
                            style="width: auto; min-width: 280px;"
                            disabled="@(!CanAssociate)" @onclick="AssociateCode">
                        <i class="fas fa-check-circle me-2"></i> CONFIRMAR ASOCIACIÓN
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<ProductRegisterForm @bind-IsVisible="showNewProductModal" Categorias="categorias" InitialBarcode="@generatedBarcode" OnProductSaved="HandleNewProductSaved" />

<style>
