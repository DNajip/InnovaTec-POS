        font-weight: 700;
        color: #2d3436;
        margin: 0;
    }

    .panel-body {
        padding: 1rem 1.25rem;
        flex-grow: 1;
        overflow: hidden;
        display: flex;
        flex-direction: column;
    }

    .panel-footer {
        padding: 1rem 1.25rem;
        background: #fdfdfd;
