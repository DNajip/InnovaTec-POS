@page "/reportes"
@using InnovaTecPOS.Backend.Services
@using InnovaTecPOS.Backend.Models
@inject IReportService ReportService
@inject AppState AppState
@inject UserSession Session
@inject IJSRuntime JS

<div class="report-main-container">
    <InnovaReportSidebar ActiveSection="@activeSection" OnSectionChanged="HandleSectionChange" />
    
    <div class="report-content">
        <!-- Header con Filtro de Fechas Compartido -->
        <div class="report-header-toolbar">
            <div class="report-title">
                <h1>Reportes</h1>
                <p>Centro de inteligencia de tu negocio</p>
            </div>
            
            <div class="report-date-selector">
                <div class="quick-ranges">
                    <button class="btn-quick @(rangeType == "hoy" ? "active" : "")" @onclick='() => SetRange("hoy")'>Hoy</button>
                    <button class="btn-quick @(rangeType == "7d" ? "active" : "")" @onclick='() => SetRange("7d")'>7 Días</button>
                    <button class="btn-quick @(rangeType == "mes" ? "active" : "")" @onclick='() => SetRange("mes")'>Mes Actual</button>
                </div>
                
                <div class="custom-range">
                    <input type="date" class="form-control form-control-sm" @bind="startDate" />
                    <span>a</span>
                    <input type="date" class="form-control form-control-sm" @bind="endDate" />
                    <button class="btn btn-primary btn-sm rounded-pill" @onclick="RefreshData">
                        <i class="fas fa-sync-alt"></i>
                    </button>
                </div>
                
                <div class="export-actions">
                    <button class="btn btn-outline-success btn-sm rounded-pill" @onclick="ExportToCSV">
                        <i class="fas fa-file-excel"></i> Exportar CSV
                    </button>
                    <button class="btn btn-outline-danger btn-sm rounded-pill">
                        <i class="fas fa-file-pdf"></i> PDF
                    </button>
                </div>
            </div>
        </div>

        <!-- Renderizado de la Sección Activa -->
        <div class="report-view-area">
            @if (activeSection == "dashboard")
            {
                <ReportDashboard StartDate="startDate" EndDate="endDate" />
            }
            else if (activeSection == "ventas")
            {
                <ReportVentas StartDate="startDate" EndDate="endDate" />
            }
            else if (activeSection == "inventario")
            {
                <ReportInventario />
            }
            else if (activeSection == "clientes")
            {
                <ReportClientes StartDate="startDate" EndDate="endDate" />
            }
            else if (activeSection == "cajeros")
            {
                <ReportCajeros StartDate="startDate" EndDate="endDate" />
            }
            else if (activeSection == "arqueos")
            {
                <ReportCaja StartDate="startDate" EndDate="endDate" />
            }
        </div>
    </div>
</div>

@code {
    private string activeSection = "dashboard";
    private string rangeType = "mes";
    private DateTime startDate { get => AppState.ReportStartDate; set => AppState.ReportStartDate = value; }
    private DateTime endDate { get => AppState.ReportEndDate; set => AppState.ReportEndDate = value; }

    protected override void OnInitialized()
    {
        if (!Session.IsAuthenticated) return;
        
        // Inicializar si es la primera vez que se entra en la sesión
        if (AppState.ReportStartDate == DateTime.MinValue || AppState.ReportStartDate == DateTime.Today)
        {
            AppState.ReportStartDate = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1);
            AppState.ReportEndDate = DateTime.Today;
        }
    }

    private void HandleSectionChange(string section)
    {
        activeSection = section;
        StateHasChanged();
    }

    private async Task SetRange(string type)
    {
        rangeType = type;
        switch (type)
        {
            case "hoy":
                startDate = DateTime.Today;
                endDate = DateTime.Today.AddDays(1).AddTicks(-1);
                break;
            case "7d":
                startDate = DateTime.Today.AddDays(-7);
                endDate = DateTime.Today.AddDays(1).AddTicks(-1);
                break;
            case "mes":
                startDate = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1);
                endDate = DateTime.Today.AddDays(1).AddTicks(-1);
                break;
        }
        await RefreshData();
    }

    private async Task RefreshData()
    {
        StateHasChanged();
    }

    private async Task ExportToCSV()
    {
        var data = await ReportService.GetResumenDiarioAsync(startDate, endDate);
        var csv = new System.Text.StringBuilder();
        csv.AppendLine("Fecha,Ventas Brutas,Ventas Netas,Facturas,Ticket Promedio");
        
        foreach (var item in data)
        {
            csv.AppendLine($"{item.Fecha:dd/MM/yyyy},{item.VentasBrutas},{item.VentasNetas},{item.Facturas},{item.TicketPromedio}");
        }

        var bytes = System.Text.Encoding.UTF8.GetBytes(csv.ToString());
        await Microsoft.JSInterop.JSRuntimeExtensions.InvokeVoidAsync(JS, "downloadFile", $"Reporte_{activeSection}_{DateTime.Now:yyyyMMdd}.csv", "text/csv", bytes);
    }
}
