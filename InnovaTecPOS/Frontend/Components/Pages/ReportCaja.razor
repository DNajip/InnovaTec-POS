@using InnovaTecPOS.Backend.Services
@using InnovaTecPOS.Backend.Models
@inject IReportService ReportService

@if (arqueos == null)
{
    <div class="text-center py-5">
        <div class="skeleton" style="height: 200px; border-radius: 20px;"></div>
    </div>
}
else
{
    <div class="report-card mb-4 shadow-sm" style="border-radius: 16px; border: none; overflow: hidden;">
        <div class="report-card-title px-4 py-3 bg-white fw-bold d-flex justify-content-between align-items-center" style="font-size: 1.1rem; color: var(--text-dark); border-bottom: 1px solid #f1f3f5;">
            <span>
                <i class="fas fa-audit me-2 text-primary"></i>Auditoría de Arqueos y Turnos
            </span>
            <div class="d-flex align-items-center text-muted" style="font-size: 0.85rem; font-weight: 500;">
                <span class="me-3"><i class="fas fa-circle text-success me-1" style="font-size: 0.7em;"></i>Cuadrado</span>
                <span class="me-3"><i class="fas fa-circle text-warning me-1" style="font-size: 0.7em;"></i>Sobrante (+)</span>
                <span><i class="fas fa-circle text-danger me-1" style="font-size: 0.7em;"></i>Faltante (-)</span>
            </div>
        </div>
        <div class="table-responsive">
            <table class="table table-hover mb-0" style="font-size: 0.82rem;">
                <thead style="background: #f8f9fa;">
                    <tr>
                        <th colspan="4" class="text-center border-end py-1">IDENTIFICACIÓN</th>
                        <th colspan="3" class="text-center border-end py-1">VENTAS</th>
                        <th colspan="3" class="text-center border-end py-1">COBROS VENTAS</th>
                        <th colspan="4" class="text-center border-end py-1">OTROS MOVIMIENTOS</th>
                        <th colspan="4" class="text-center py-1">CAJA</th>
                    </tr>
                    <tr>
                        <!-- Identificación -->
                        <th class="ps-3 py-2 text-uppercase small fw-bold text-muted text-nowrap">Turno</th>
                        <th class="px-2 py-2 text-uppercase small fw-bold text-muted text-nowrap">Cajero</th>
                        <th class="px-2 py-2 text-uppercase small fw-bold text-muted text-nowrap">Moneda</th>
                        <th class="px-2 py-2 text-uppercase small fw-bold text-muted text-end text-nowrap border-end">Inicial</th>
                        <!-- Ventas -->
                        <th class="px-2 py-2 text-uppercase small fw-bold text-muted text-end text-nowrap">Efectuadas</th>
                        <th class="px-2 py-2 text-uppercase small fw-bold text-muted text-end text-nowrap">Anuladas</th>
                        <th class="px-2 py-2 text-uppercase small fw-bold text-muted text-end text-nowrap border-end">Netas</th>
                        <!-- Cobros Ventas -->
                        <th class="px-2 py-2 text-uppercase small fw-bold text-muted text-end text-nowrap">Efectivo</th>
                        <th class="px-2 py-2 text-uppercase small fw-bold text-muted text-end text-nowrap">Transf.</th>
                        <th class="px-2 py-2 text-uppercase small fw-bold text-muted text-end text-nowrap border-end">Tarj.</th>
                        <!-- Otros Movimientos -->
                        <th class="px-2 py-2 text-uppercase small fw-bold text-muted text-end text-nowrap">Ingresos</th>
                        <th class="px-2 py-2 text-uppercase small fw-bold text-muted text-end text-nowrap">Retiros</th>
                        <th class="px-2 py-2 text-uppercase small fw-bold text-muted text-end text-nowrap">Reversos</th>
                        <th class="px-2 py-2 text-uppercase small fw-bold text-muted text-end text-nowrap border-end">Vuelto</th>
                        <!-- Caja -->
                        <th class="px-2 py-2 text-uppercase small fw-bold text-muted text-end text-nowrap">Teórico</th>
                        <th class="px-2 py-2 text-uppercase small fw-bold text-muted text-end text-nowrap">Real</th>
                        <th class="px-2 py-2 text-uppercase small fw-bold text-muted text-end text-nowrap">Diferencia</th>
                        <th class="px-2 py-2 text-uppercase small fw-bold text-muted text-center text-nowrap">Estado</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!arqueos.Any())
                    {
                        <tr>
                            <td colspan="18" class="text-center py-5 text-muted">
                                <i class="fas fa-receipt fa-2x mb-2 opacity-50"></i>
                                <p class="mb-0">No hay registros para este período</p>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var a in arqueos.Skip((currentPage - 1) * pageSize).Take(pageSize))
                        {
                            <tr style="transition: all 0.2s; cursor: pointer; @(a.EsFilaPrincipal ? "border-top: 2px solid #dee2e6; background-color: #ffffff;" : "background-color: #f4f8ff;")" 
                                class="@(selectedTurnoId == a.IdTurno ? "table-primary" : "")"
                                @onclick="() => SelectTurno(a.IdTurno)">
                                
                                @if (a.EsFilaPrincipal)
                                {
                                    <td class="ps-3 py-2 fw-bold text-primary text-nowrap" rowspan="2" style="vertical-align: middle;">
                                        #@a.IdTurno<br>
                                        <span class="text-muted fw-normal" style="font-size: 0.7rem;">@a.Apertura.ToString("dd/MM")</span>
                                    </td>
                                    <td class="px-2 py-2 fw-semibold text-nowrap" rowspan="2" style="vertical-align: middle;">
                                        @a.Usuario<br>
                                        @if (a.Estado == "EN CURSO")
                                        {
                                            <span class="badge bg-primary bg-opacity-10 text-primary px-2 py-1 rounded-pill fw-bold" style="font-size: 0.65rem;">EN CURSO</span>
                                        }
                                    </td>
                                }
                                <td class="px-2 py-2 fw-bold text-nowrap">@a.Moneda</td>
                                <td class="px-2 py-2 text-end fw-semibold text-nowrap border-end">@a.MontoInicial.ToString("N2")</td>
                                
                                <!-- Ventas -->
                                <td class="px-2 py-2 text-end text-muted text-nowrap">@(a.VentasEfectuadas > 0 ? a.VentasEfectuadas.ToString() : "--")</td>
                                <td class="px-2 py-2 text-end text-muted text-nowrap">@(a.VentasAnuladas > 0 ? a.VentasAnuladas.ToString() : "--")</td>
                                <td class="px-2 py-2 text-end fw-bold text-primary text-nowrap border-end">@(a.VentasNetas > 0 ? a.VentasNetas.ToString("N2") : "--")</td>
                                
                                <!-- Cobros Ventas -->
                                <td class="px-2 py-2 text-end fw-semibold text-nowrap">@(a.CobrosEfectivo > 0 ? a.CobrosEfectivo.ToString("N2") : "0.00")</td>
                                <td class="px-2 py-2 text-end text-info fw-semibold text-nowrap">@(a.CobrosTransferencia > 0 ? a.CobrosTransferencia.ToString("N2") : "0.00")</td>
                                <td class="px-2 py-2 text-end text-info fw-semibold text-nowrap border-end">@(a.CobrosTarjeta > 0 ? a.CobrosTarjeta.ToString("N2") : "0.00")</td>
                                
                                <!-- Otros Movimientos -->
                                <td class="px-2 py-2 text-end text-success fw-semibold text-nowrap">@(a.OtrosIngresos > 0 ? a.OtrosIngresos.ToString("N2") : "0.00")</td>
                                <td class="px-2 py-2 text-end text-danger fw-semibold text-nowrap">@(a.OtrosRetiros > 0 ? a.OtrosRetiros.ToString("N2") : "0.00")</td>
                                <td class="px-2 py-2 text-end text-danger fw-semibold text-nowrap">@(a.Reversos > 0 ? a.Reversos.ToString("N2") : "0.00")</td>
                                <td class="px-2 py-2 text-end text-danger fw-semibold text-nowrap border-end">@(a.VueltoEntregado > 0 ? a.VueltoEntregado.ToString("N2") : "0.00")</td>
                                
                                <!-- Caja -->
                                <td class="px-2 py-2 text-end fw-bold text-dark text-nowrap">@a.SaldoTeorico.ToString("N2")</td>
                                <td class="px-2 py-2 text-end fw-bold text-nowrap">@(a.Estado == "EN CURSO" ? "--" : a.SaldoReal.ToString("N2"))</td>
                                <td class="px-2 py-2 text-end fw-bold text-nowrap @(a.Diferencia < 0 ? "text-danger" : a.Diferencia > 0 ? "text-warning" : "text-success")">
                                    @(a.Estado == "EN CURSO" ? "--" : (a.Diferencia > 0 ? "+" + a.Diferencia.ToString("N2") : a.Diferencia.ToString("N2")))
                                </td>
                                <td class="px-2 py-2 text-center text-nowrap">
                                    @if(a.EstadoCalculado == "CUADRADO") { <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-2">CUADRADO</span> }
                                    else if(a.EstadoCalculado == "EN CURSO") { <span class="badge bg-secondary bg-opacity-10 text-secondary border border-secondary border-opacity-25 px-2">ABIERTO</span> }
                                    else if(a.EstadoCalculado == "SOBRANTE") { <span class="badge bg-warning bg-opacity-10 text-warning border border-warning border-opacity-25 px-2">SOBRANTE</span> }
                                    else if(a.EstadoCalculado == "FALTANTE") { <span class="badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25 px-2">FALTANTE</span> }
                                    else { <span class="badge bg-dark bg-opacity-10 text-dark border border-dark border-opacity-25 px-2">@a.EstadoCalculado</span> }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        @if (arqueos != null && arqueos.Count > pageSize)
        {
            var totalPages = (int)Math.Ceiling((double)arqueos.Count / pageSize);
            <div class="pagination-container p-3 border-top bg-white d-flex justify-content-center align-items-center position-relative">
                <div class="position-absolute start-0 ps-4 d-none d-lg-block">
                    <span class="small text-muted">Mostrando @(Math.Min(arqueos.Count, (currentPage - 1) * pageSize + 1)) a @(Math.Min(arqueos.Count, currentPage * pageSize)) de @arqueos.Count registros</span>
                </div>
                <div class="pagination-carousel-container">
                    <ul class="pagination pagination-premium mb-0">
                        <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                            <button class="page-link" @onclick="() => SetPage(currentPage - 1)" title="Anterior">
                                <i class="fas fa-chevron-left"></i>
                            </button>
                        </li>
                        
                        @{
                            int maxVisible = 5;
                            int startPage = Math.Max(1, Math.Min(currentPage - 2, totalPages - maxVisible + 1));
                            int endPage = Math.Min(totalPages, startPage + maxVisible - 1);
                            
                            if (totalPages > maxVisible && endPage == totalPages) startPage = Math.Max(1, totalPages - maxVisible + 1);

                            for (int i = startPage; i <= endPage; i++)
                            {
                                var pageNum = i;
                                <li class="page-item @(currentPage == pageNum ? "active" : "") page-item-animated" @key="pageNum">
                                    <button class="page-link" @onclick="() => SetPage(pageNum)">@pageNum</button>
                                </li>
                            }

                            if (endPage < totalPages)
                            {
                                if (endPage < totalPages - 1)
                                {
                                    <li class="pagination-ellipsis">...</li>
                                }
                                <li class="page-item @(currentPage == totalPages ? "active" : "") page-item-animated">
                                    <button class="page-link" @onclick="() => SetPage(totalPages)">@totalPages</button>
                                </li>
                            }
                        }

                        <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                            <button class="page-link" @onclick="() => SetPage(currentPage + 1)" title="Siguiente">
                                <i class="fas fa-chevron-right"></i>
                            </button>
                        </li>
                    </ul>
                </div>
            </div>
        }
    </div>

    <!-- Historial de movimientos por turno -->
    <div class="report-card mb-4 shadow-sm animate__animated animate__fadeInUp" style="border-radius: 16px; border: none; overflow: hidden;">
        <div class="report-card-title px-4 py-3 bg-white d-flex justify-content-between align-items-center" style="border-bottom: 1px solid #f1f3f5;">
            <span class="fw-bold" style="font-size: 1.1rem; color: var(--text-dark);">
                <i class="fas fa-history me-2 text-primary"></i>
                @(selectedTurnoId == null ? "Seleccione un turno para ver historial de movimientos" : $"Historial de movimientos por turno #{selectedTurnoId}")
            </span>
            @if (loadingMovimientos)
            {
                <div class="spinner-border spinner-border-sm text-primary" role="status"></div>
            }
        </div>
        
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead style="background: #f8f9fa;">
                    <tr>
                        <th class="ps-4 py-3 text-uppercase small fw-bold text-muted">Tipo</th>
                        <th class="py-3 text-uppercase small fw-bold text-muted">Referencia</th>
                        <th class="py-3 text-uppercase small fw-bold text-muted">Hora</th>
                        <th class="py-3 text-uppercase small fw-bold text-muted">Cliente</th>
                        <th class="py-3 text-uppercase small fw-bold text-muted text-end">Descuento</th>
                        <th class="py-3 text-uppercase small fw-bold text-muted text-end">Monto Total</th>
                        <th class="py-3 text-uppercase small fw-bold text-muted text-end">Pagado</th>
                        <th class="py-3 text-uppercase small fw-bold text-muted text-end">Vuelto</th>
                        <th class="py-3 text-uppercase small fw-bold text-muted text-end">Reverso</th>
                        <th class="py-3 text-uppercase small fw-bold text-muted ps-3">Método Pago</th>
                        <th class="py-3 text-uppercase small fw-bold text-muted pe-4">Estado</th>
                    </tr>
                </thead>
                <tbody>
                    @if (selectedTurnoId == null)
                    {
                        <tr>
                            <td colspan="11" class="text-center py-5 text-muted">
                                <i class="fas fa-mouse-pointer fa-2x mb-2 opacity-50"></i>
                                <p class="mb-0">Haga clic en un turno de la tabla superior para ver sus detalles</p>
                            </td>
                        </tr>
                    }
                    else if (loadingMovimientos)
                    {
                        @for (int i = 0; i < 3; i++)
                        {
                            <tr>
                                <td colspan="11" class="py-3 ps-4"><div class="skeleton" style="height: 20px;"></div></td>
                            </tr>
                        }
                    }
                    else if (movimientosTurno == null || !movimientosTurno.Any())
                    {
                        <tr>
                            <td colspan="11" class="text-center py-5 text-muted">
                                <i class="fas fa-info-circle fa-2x mb-2 opacity-50"></i>
                                <p class="mb-0">No se encontraron movimientos para este turno</p>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var v in movimientosTurno.Skip((currentPageMovimientos - 1) * pageSizeMovimientos).Take(pageSizeMovimientos))
                        {
                            <tr>
                                <td class="ps-4 py-3 fw-bold">
                                    @if (v.TipoMovimiento == "Venta")
                                    {
                                        <span class="badge bg-primary bg-opacity-10 text-primary px-2 rounded">VENTA</span>
                                    }
                                    else if (v.TipoMovimiento == "Regalía")
                                    {
                                        <span class="badge bg-warning bg-opacity-10 text-warning px-2 rounded">REGALÍA</span>
                                    }
                                    else if (v.TipoMovimiento == "Reverso")
                                    {
                                        <span class="badge bg-danger bg-opacity-10 text-danger px-2 rounded">REVERSO</span>
                                    }
                                    else if (v.TipoMovimiento == "Ingreso")
                                    {
                                        <span class="badge bg-success bg-opacity-10 text-success px-2 rounded">INGRESO</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger bg-opacity-10 text-danger px-2 rounded">EGRESO</span>
                                    }
                                </td>
                                <td class="py-3 fw-bold">@v.Referencia</td>
                                <td class="py-3 text-muted">@v.Fecha.ToString("hh:mm tt")</td>
                                <td class="py-3">
                                    @if(v.Cliente == "N/A" || v.Cliente == "--")
                                    {
                                        <span class="text-muted fst-italic">--</span>
                                    }
                                    else
                                    {
                                        @v.Cliente
                                    }
                                </td>
                                <!-- Descuento -->
                                <td class="py-3 text-end fw-semibold text-warning">
                                    @(v.Descuento > 0 ? $"{v.SimboloMonedaMonto} {v.Descuento:N2}" : "--")
                                </td>
                                <!-- Monto Total -->
                                <td class="py-3 text-end fw-bold @(v.TipoMovimiento == "Egreso" || v.TipoMovimiento == "Reverso" ? "text-danger" : "text-primary")">
                                    @(v.TipoMovimiento == "Egreso" || v.TipoMovimiento == "Reverso" ? "-" : "")@v.SimboloMonedaMonto @v.MontoTotal.ToString("N2")
                                </td>
                                <!-- Pagado -->
                                <td class="py-3 text-end fw-bold text-success">
                                    @(v.MontoPagado > 0 ? $"{v.SimboloMonedaPago} {v.MontoPagado:N2}" : "--")
                                </td>
                                <!-- Vuelto -->
                                <td class="py-3 text-end fw-semibold text-danger">
                                    @(v.Vuelto > 0 ? $"{v.SimboloMonedaVuelto} {v.Vuelto:N2}" : "--")
                                </td>
                                <!-- Reverso -->
                                <td class="py-3 text-end fw-bold text-danger">
                                    @(v.MontoReverso > 0 ? $"{v.SimboloMonedaMonto} {v.MontoReverso:N2}" : "--")
                                </td>
                                <!-- Método Pago -->
                                <td class="py-3 ps-3">
                                    <span class="small fw-semibold text-muted">@v.MetodoPago</span>
                                </td>
                                <!-- Estado -->
                                <td class="py-3 pe-4">
                                    @if (v.Estado == "ANULADA")
                                    {
                                        <span class="badge bg-danger bg-opacity-10 text-danger rounded-pill">ANULADA</span>
                                    }
                                    else if (v.Estado == "EFECTUADA")
                                    {
                                        <span class="badge bg-success bg-opacity-10 text-success rounded-pill">EFECTUADA</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary bg-opacity-10 text-secondary rounded-pill">COMPLETADO</span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        @if (movimientosTurno != null && movimientosTurno.Count > pageSizeMovimientos)
        {
            var totalPages = (int)Math.Ceiling((double)movimientosTurno.Count / pageSizeMovimientos);
            <div class="pagination-container p-3 border-top bg-white d-flex justify-content-center align-items-center position-relative">
                <div class="position-absolute start-0 ps-4 d-none d-lg-block">
                    <span class="small text-muted">Mostrando @(Math.Min(movimientosTurno.Count, (currentPageMovimientos - 1) * pageSizeMovimientos + 1)) a @(Math.Min(movimientosTurno.Count, currentPageMovimientos * pageSizeMovimientos)) de @movimientosTurno.Count registros</span>
                </div>
                <div class="pagination-carousel-container">
                    <ul class="pagination pagination-premium mb-0">
                        <li class="page-item @(currentPageMovimientos == 1 ? "disabled" : "")">
                            <button class="page-link" @onclick="() => SetPageMovimientos(currentPageMovimientos - 1)" title="Anterior">
                                <i class="fas fa-chevron-left"></i>
                            </button>
                        </li>
                        
                        @{
                            int maxVisible = 5;
                            int startPage = Math.Max(1, Math.Min(currentPageMovimientos - 2, totalPages - maxVisible + 1));
                            int endPage = Math.Min(totalPages, startPage + maxVisible - 1);
                            
                            if (totalPages > maxVisible && endPage == totalPages) startPage = Math.Max(1, totalPages - maxVisible + 1);

                            for (int i = startPage; i <= endPage; i++)
                            {
                                var pageNum = i;
                                <li class="page-item @(currentPageMovimientos == pageNum ? "active" : "") page-item-animated" @key="@("m-" + pageNum)">
                                    <button class="page-link" @onclick="() => SetPageMovimientos(pageNum)">@pageNum</button>
                                </li>
                            }

                            if (endPage < totalPages)
                            {
                                if (endPage < totalPages - 1)
                                {
                                    <li class="pagination-ellipsis">...</li>
                                }
                                <li class="page-item @(currentPageMovimientos == totalPages ? "active" : "") page-item-animated">
                                    <button class="page-link" @onclick="() => SetPageMovimientos(totalPages)">@totalPages</button>
                                </li>
                            }
                        }

                        <li class="page-item @(currentPageMovimientos == totalPages ? "disabled" : "")">
                            <button class="page-link" @onclick="() => SetPageMovimientos(currentPageMovimientos + 1)" title="Siguiente">
                                <i class="fas fa-chevron-right"></i>
                            </button>
                        </li>
                    </ul>
                </div>
            </div>
        }
    </div>
}

@code {
    [Parameter] public DateTime StartDate { get; set; }
    [Parameter] public DateTime EndDate { get; set; }
    private List<ArqueoInsightDTO>? arqueos;
    private int currentPage = 1;
    private int pageSize = 10;

    private int? selectedTurnoId;
    private List<MovimientoTurnoDTO>? movimientosTurno;
    private bool loadingMovimientos = false;
    private int currentPageMovimientos = 1;
    private int pageSizeMovimientos = 10;

    protected override async Task OnParametersSetAsync() 
    {
        currentPage = 1; // Reset al cambiar fechas
        selectedTurnoId = null;
        movimientosTurno = null;
        await LoadData();
    }

    private async Task LoadData()
    {
        arqueos = null;
        StateHasChanged();
        arqueos = await ReportService.GetArqueoInsightsAsync(StartDate, EndDate);
        StateHasChanged();
    }

    private async Task SelectTurno(int idTurno)
    {
        if (selectedTurnoId == idTurno) return;
        
        selectedTurnoId = idTurno;
        currentPageMovimientos = 1;
        loadingMovimientos = true;
        movimientosTurno = null;
        StateHasChanged();
        
        movimientosTurno = await ReportService.GetMovimientosPorTurnoAsync(idTurno);
        loadingMovimientos = false;
        StateHasChanged();
    }

    private void SetPage(int page)
    {
        currentPage = page;
        StateHasChanged();
    }

    private void SetPageMovimientos(int page)
    {
        currentPageMovimientos = page;
        StateHasChanged();
    }
}
